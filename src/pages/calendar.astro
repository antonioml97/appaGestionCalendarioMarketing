---
import AppShell from '../components/AppShell.astro';
import Icon from '../components/Icon.astro';
import DayTimeline from '../features/calendar/components/DayTimeline.astro';
import EventDetailPanel from '../features/calendar/components/EventDetailPanel.astro';
import EventFormModal from '../features/calendar/components/EventFormModal.astro';
import MobileAgenda from '../features/calendar/components/MobileAgenda.astro';
import MonthlyCalendar from '../features/calendar/components/MonthlyCalendar.astro';
import SidebarFilters from '../features/calendar/components/SidebarFilters.astro';
import WeekCalendar from '../features/calendar/components/WeekCalendar.astro';
import { getCalendarPageData } from '../features/calendar/server';
import { capitalize, formatMonthYear } from '../lib/format';
import { buildHref } from '../lib/url';

const currentUser = Astro.locals.currentUser!;
const {
  dataset,
  searchParams,
  view,
  focusDate,
  selectedClientIds,
  selectedTypeIds,
  selectedStatuses,
  search,
  mobileScope,
  selectedEvent,
  monthMatrix,
  eventsByDay,
  weekItems,
  dayEvents,
  agendaGroups,
  desktopAgendaGroups,
  workload,
  previousDate,
  nextDate,
  previousMobileDate,
  nextMobileDate,
  clearEventHref,
  closeModalHref,
  eventEditHref,
  redirectTo,
  showEventModal,
  modalEvent,
  draftStartsAt,
} = await getCalendarPageData(Astro.url, currentUser);

const mobilePeriodLabel =
  mobileScope === 'day' ? 'Día' : mobileScope === 'week' ? 'Semana' : 'Mes';
---

<AppShell
  title="Calendario | Marketing Planner"
  currentPath="/calendar"
  currentUser={currentUser}
  organization={dataset.organization}
>
  <section class="md:hidden">
    <div class="mb-4 grid grid-cols-[auto_auto_minmax(0,1fr)_auto_auto] items-center gap-1 rounded-[28px] border border-white/80 bg-white/90 px-3 py-4 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.34)]">
      <button
        id="open-mobile-filters"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-orange-50 text-orange-700 transition active:bg-orange-100"
        aria-label="Abrir menú de filtros"
        aria-controls="mobile-filters-menu"
        aria-expanded="false"
      >
        <Icon name="menu" size={18} />
      </button>
      <a
        href={buildHref('/calendar', searchParams, { date: previousMobileDate.toISOString() })}
        class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-50 text-slate-600 transition active:bg-slate-100"
        aria-label={`${mobilePeriodLabel} anterior`}
      >
        <Icon name="chevron-left" size={18} />
      </a>
      <div class="min-w-0 text-center">
        <p class="truncate font-display text-xl font-semibold text-slate-900">
          {capitalize(formatMonthYear(focusDate))}
        </p>
      </div>
      <div class="contents">
        <a
          href={buildHref('/calendar', searchParams, { date: nextMobileDate.toISOString() })}
          class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-50 text-slate-600 transition active:bg-slate-100"
          aria-label={`${mobilePeriodLabel} siguiente`}
        >
          <Icon name="chevron-right" size={18} />
        </a>
        <a
          href={buildHref('/calendar', searchParams, { modal: 'new-event' })}
          class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-[#f5a34c] text-slate-950 shadow-lg shadow-orange-500/25 transition hover:brightness-105"
          aria-label="Nuevo evento"
        >
          <Icon name="plus" size={18} />
        </a>
      </div>
    </div>

    <div id="mobile-filters-menu" class="fixed inset-0 z-50 hidden" aria-hidden="true">
      <button
        id="close-mobile-filters-backdrop"
        type="button"
        class="absolute inset-0 bg-slate-950/35 backdrop-blur-sm"
        aria-label="Cerrar menú de filtros"
      ></button>
      <div class="absolute inset-y-0 left-0 flex w-[min(88vw,360px)] flex-col bg-slate-50 shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-200 bg-white px-4 py-4">
          <div>
            <p class="font-display text-xl font-semibold text-slate-950">Filtros</p>
            <p class="text-xs text-slate-500">Personaliza el calendario</p>
          </div>
          <button
            id="close-mobile-filters"
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-slate-600"
            aria-label="Cerrar menú de filtros"
          >
            <Icon name="close" size={18} />
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-4 pb-28">
          <SidebarFilters
            clients={dataset.clients}
            eventTypes={dataset.eventTypes}
            statuses={['pending', 'in_progress', 'completed', 'published', 'cancelled']}
            selectedClientIds={selectedClientIds}
            selectedTypeIds={selectedTypeIds}
            selectedStatuses={selectedStatuses}
            searchParams={searchParams}
            workload={workload}
          />
        </div>
      </div>
    </div>

    <div class="mb-4 rounded-[28px] border border-white/80 bg-white/95 p-2 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.34)]">
      <div class="grid grid-cols-3 gap-2">
        {[
          { label: 'Hoy', scope: 'day' },
          { label: 'Semana', scope: 'week' },
          { label: 'Mes', scope: 'month' },
        ].map((item) => (
          <a
            href={buildHref('/calendar', searchParams, { scope: item.scope })}
            class:list={[
              'rounded-2xl px-3 py-2 text-center text-sm font-semibold transition',
              mobileScope === item.scope ? 'bg-orange-50 text-orange-700' : 'text-slate-500',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <MobileAgenda
      groups={agendaGroups}
      selectedEventId={selectedEvent?.id}
      searchParams={searchParams}
    />

    {selectedEvent && (
      <div class="fixed inset-x-0 bottom-24 z-40 px-4">
        <EventDetailPanel
          event={selectedEvent}
          closeHref={clearEventHref}
          editHref={eventEditHref}
          redirectTo={redirectTo}
          mobile
        />
      </div>
    )}
  </section>

  <section class="hidden md:block">
    <div class="grid gap-6 xl:grid-cols-[280px_minmax(0,1fr)_340px]">
      <SidebarFilters
        clients={dataset.clients}
        eventTypes={dataset.eventTypes}
        statuses={['pending', 'in_progress', 'completed', 'published', 'cancelled']}
        selectedClientIds={selectedClientIds}
        selectedTypeIds={selectedTypeIds}
        selectedStatuses={selectedStatuses}
        searchParams={searchParams}
        workload={workload}
      />

      <div class="space-y-6">
        <div class="rounded-[32px] border border-white/80 bg-white/92 p-5 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.35)] lg:p-6">
          <div class="grid gap-4 xl:grid-cols-[minmax(280px,360px)_1fr] xl:items-center">
            <form method="GET" action="/calendar" class="relative min-w-0 flex-1">
              <Icon
                name="search"
                class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
                size={17}
              />
              <input
                type="search"
                name="search"
                value={search}
                placeholder="Buscar eventos, empresas..."
                class="w-full rounded-[22px] border border-slate-200 bg-slate-50 py-3 pl-12 pr-4 text-sm text-slate-800 outline-none transition focus:border-orange-200 focus:bg-white focus:ring-4 focus:ring-orange-50"
              />
              {selectedClientIds.map((id) => <input type="hidden" name="client" value={id} />)}
              {selectedTypeIds.map((id) => <input type="hidden" name="type" value={id} />)}
              {selectedStatuses.map((status) => <input type="hidden" name="status" value={status} />)}
              <input type="hidden" name="view" value={view} />
              <input type="hidden" name="date" value={focusDate.toISOString()} />
            </form>

            <div class="flex flex-wrap items-center justify-end gap-3">
              <div class="flex items-center gap-2 rounded-[22px] border border-slate-200 bg-white px-3 py-2">
                <a
                  href={buildHref('/calendar', searchParams, { date: previousDate.toISOString() })}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-2xl text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
                >
                  <Icon name="chevron-left" size={16} />
                </a>
                <p class="min-w-40 text-center font-display text-2xl font-semibold text-slate-900">
                  {capitalize(formatMonthYear(focusDate))}
                </p>
                <a
                  href={buildHref('/calendar', searchParams, { date: nextDate.toISOString() })}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-2xl text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
                >
                  <Icon name="chevron-right" size={16} />
                </a>
              </div>

              <div class="flex items-center gap-2 rounded-[22px] border border-slate-200 bg-slate-50 p-1">
                {[
                  { label: 'Mes', view: 'month' },
                  { label: 'Semana', view: 'week' },
                  { label: 'Dia', view: 'day' },
                  { label: 'Agenda', view: 'agenda' },
                ].map((item) => (
                  <a
                    href={buildHref('/calendar', searchParams, { view: item.view })}
                    class:list={[
                      'rounded-2xl px-4 py-2 text-sm font-semibold transition',
                      view === item.view
                        ? 'bg-white text-orange-700 shadow-sm'
                        : 'text-slate-500 hover:text-slate-800',
                    ]}
                  >
                    {item.label}
                  </a>
                ))}
              </div>

              <a
                href={buildHref('/calendar', searchParams, { modal: 'new-event' })}
                class="inline-flex items-center gap-2 rounded-[22px] bg-[linear-gradient(135deg,_#f5a34c,_#ffa749)] px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-orange-500/25 transition hover:brightness-105"
              >
                <Icon name="plus" size={16} />
                Nuevo evento
              </a>
            </div>
          </div>
        </div>

        {view === 'week' && (
          <WeekCalendar
            weekItems={weekItems}
            selectedEventId={selectedEvent?.id}
            searchParams={searchParams}
          />
        )}
        {view === 'day' && (
          <DayTimeline
            focusDate={focusDate}
            events={dayEvents}
            selectedEventId={selectedEvent?.id}
            searchParams={searchParams}
          />
        )}
        {view === 'agenda' && (
          <MobileAgenda
            groups={desktopAgendaGroups}
            selectedEventId={selectedEvent?.id}
            searchParams={searchParams}
          />
        )}
        {view === 'month' && (
          <MonthlyCalendar
            matrix={monthMatrix}
            eventsByDay={eventsByDay}
            selectedEventId={selectedEvent?.id}
            searchParams={searchParams}
          />
        )}
      </div>

      <div class="hidden xl:block">
        <EventDetailPanel
          event={selectedEvent}
          closeHref={clearEventHref}
          editHref={eventEditHref}
          redirectTo={redirectTo}
        />
      </div>
    </div>
  </section>

  <EventFormModal
    open={showEventModal}
    closeHref={closeModalHref}
    clients={dataset.clients.filter((client) => client.active)}
    eventTypes={dataset.eventTypes.filter((type) => type.active)}
    currentUser={currentUser}
    event={modalEvent}
    redirectTo={redirectTo}
    draftStartsAt={draftStartsAt}
  />

  <script>
    const mobileFiltersMenu = document.querySelector('#mobile-filters-menu');
    const openMobileFilters = document.querySelector('#open-mobile-filters');
    const closeMobileFilters = document.querySelector('#close-mobile-filters');
    const closeMobileFiltersBackdrop = document.querySelector('#close-mobile-filters-backdrop');

    const setMobileFiltersOpen = (open: boolean) => {
      if (!(mobileFiltersMenu instanceof HTMLElement)) return;

      mobileFiltersMenu.classList.toggle('hidden', !open);
      mobileFiltersMenu.setAttribute('aria-hidden', String(!open));
      openMobileFilters?.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('overflow-hidden', open);

      if (open && closeMobileFilters instanceof HTMLElement) closeMobileFilters.focus();
      else if (openMobileFilters instanceof HTMLElement) openMobileFilters.focus();
    };

    openMobileFilters?.addEventListener('click', () => setMobileFiltersOpen(true));
    closeMobileFilters?.addEventListener('click', () => setMobileFiltersOpen(false));
    closeMobileFiltersBackdrop?.addEventListener('click', () => setMobileFiltersOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileFiltersMenu?.getAttribute('aria-hidden') === 'false') {
        setMobileFiltersOpen(false);
      }
    });
  </script>
</AppShell>
