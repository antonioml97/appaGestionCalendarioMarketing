---
import AppShell from '../components/AppShell.astro';
import Icon from '../components/Icon.astro';
import { getOrganizationBundle } from '../db/repository';
import EventCard from '../features/calendar/components/EventCard.astro';
import { parseDateParam } from '../lib/calendar';
import { formatMonthYear } from '../lib/format';
import { getDashboardMetrics, getUpcomingEvents, resolveEvents } from '../lib/planner';

const currentUser = Astro.locals.currentUser!;
const dataset = await getOrganizationBundle(currentUser);
const resolvedEvents = resolveEvents(dataset);
const baseDate = parseDateParam(Astro.url.searchParams.get('date'));
const metrics = getDashboardMetrics(resolvedEvents, baseDate);
const upcoming = getUpcomingEvents(resolvedEvents, baseDate, 6);
---

<AppShell
  title="Dashboard | Marketing Planner"
  currentPath="/dashboard"
  currentUser={currentUser}
  organization={dataset.organization}
>
  <section class="mb-4 md:hidden">
    <div class="rounded-[28px] border border-white/80 bg-white/90 px-5 py-5 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.35)]">
      <p class="text-sm text-slate-500">Dashboard</p>
      <h1 class="mt-1 font-display text-3xl font-semibold text-slate-950">Vista general</h1>
    </div>
  </section>

  <section class="grid gap-6">
    <article class="rounded-[28px] border border-orange-200/70 bg-[linear-gradient(135deg,_#f5a34c,_#ffa749)] p-4 text-slate-950 shadow-[0_32px_90px_-44px_rgba(245,163,76,0.65)] md:rounded-[36px] md:p-6 lg:p-8">
      <div class="grid gap-4 md:gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-end lg:gap-8">
        <div>
          <h1 class="font-display text-3xl leading-[1.02] font-semibold md:text-5xl">Vista general</h1>
        </div>
        <div class="grid grid-cols-2 gap-3 md:gap-4">
          {[
            { label: 'Eventos proximos 7 dias', value: metrics.weekTotal, icon: 'calendar' as const },
            { label: 'Pendientes', value: metrics.pendingTotal, icon: 'clock' as const },
            { label: 'Publicados', value: metrics.publishedTotal, icon: 'publish' as const },
            { label: 'Empresas activas', value: metrics.activeClients, icon: 'company' as const },
          ].map((metric) => (
            <div class="min-w-0 rounded-[20px] border border-white/45 bg-white/30 p-3 backdrop-blur md:rounded-[28px] md:p-5">
              <div class="mb-2 flex h-8 w-8 items-center justify-center rounded-xl bg-white/45 text-orange-800 md:mb-4 md:h-11 md:w-11 md:rounded-2xl">
                <Icon name={metric.icon} size={16} />
              </div>
              <p class="text-2xl font-semibold md:text-4xl">{metric.value}</p>
              <p class="mt-1 text-[11px] leading-4 font-semibold text-slate-700 md:mt-2 md:text-sm">{metric.label}</p>
            </div>
          ))}
        </div>
      </div>
    </article>

    <section class="rounded-[32px] border border-white/80 bg-white/95 p-6 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.35)]">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <p class="text-sm text-slate-500">Proximos eventos</p>
          <h2 class="font-display text-3xl font-semibold text-slate-950">
            {formatMonthYear(baseDate)}
          </h2>
        </div>
        <a
          href="/calendar"
          class="inline-flex items-center gap-2 rounded-full bg-orange-50 px-4 py-2 text-sm font-semibold text-orange-700"
        >
          Ir al calendario
          <Icon name="chevron-right" size={14} />
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {upcoming.map((event) => (
          <EventCard event={event} href={`/calendar?event=${event.id}`} mode="list" />
        ))}
      </div>
    </section>
  </section>
</AppShell>
