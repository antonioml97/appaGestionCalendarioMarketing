---
import { capitalize, formatLongDate } from '../../../lib/format';
import { isSameDay } from '../../../lib/calendar';
import { buildHref } from '../../../lib/url';
import type { ResolvedCalendarEvent } from '../../../types/planner';
import EventCard from './EventCard.astro';

/**
 * Props para la agenda agrupada por dia en movil o modo lista.
 */
interface Props {
  groups: { date: Date; events: ResolvedCalendarEvent[] }[];
  selectedEventId?: string;
  searchParams: URLSearchParams;
}

const { groups, selectedEventId, searchParams } = Astro.props;
const today = new Date();
---

<div class="space-y-4">
  {groups.length === 0 && (
    <section class="rounded-[28px] border border-white/80 bg-white/95 px-5 py-10 text-center shadow-[0_18px_40px_-30px_rgba(15,23,42,0.32)]">
      <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-orange-50 text-2xl text-orange-400" aria-hidden="true">·</span>
      <p class="font-display text-lg font-semibold text-slate-800">No hay eventos en este periodo</p>
      <p class="mt-1 text-sm text-slate-500">Puedes crear uno nuevo con el botón +.</p>
    </section>
  )}
  {groups.map((group) => (
    <section class:list={[
      'rounded-[28px] border bg-white/95 p-4 shadow-[0_18px_40px_-30px_rgba(15,23,42,0.32)]',
      isSameDay(group.date, today) ? 'border-orange-300 ring-2 ring-orange-100' : 'border-white/80',
    ]}>
      <div class="mb-4 flex items-center justify-between gap-3">
        <h3 class:list={[
          'text-sm font-semibold',
          isSameDay(group.date, today) ? 'text-orange-700' : 'text-slate-500',
        ]}>{capitalize(formatLongDate(group.date))}</h3>
        {isSameDay(group.date, today) && (
          <span class="shrink-0 rounded-full bg-orange-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-orange-700">Hoy</span>
        )}
      </div>
      <div class="space-y-3">
        {group.events.length === 0 && (
          <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/80 px-4 py-5 text-center">
            <p class="text-sm font-semibold text-slate-600">Sin eventos</p>
            <p class="mt-1 text-xs text-slate-400">No hay nada programado para este día.</p>
          </div>
        )}
        {group.events.map((event) => (
          <EventCard
            event={event}
            href={buildHref('/calendar', searchParams, { event: event.id })}
            selected={selectedEventId === event.id}
            mode="list"
          />
        ))}
      </div>
    </section>
  ))}
</div>
