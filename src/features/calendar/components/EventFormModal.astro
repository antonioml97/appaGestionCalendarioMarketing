---
import type { Client, EventType, PlannerUser, ResolvedCalendarEvent } from '../../../types/planner';
import Icon from '../../../components/Icon.astro';

interface Props {
  open: boolean;
  closeHref: string;
  clients: Client[];
  eventTypes: EventType[];
  currentUser: PlannerUser;
  event?: ResolvedCalendarEvent;
  redirectTo: string;
  draftStartsAt?: string;
}

const { open, closeHref, clients, eventTypes, currentUser, event, redirectTo, draftStartsAt } = Astro.props;
const selectedClient =
  clients.find((client) => client.id === event?.clientId) ?? clients[0];

const toDateTimeLocal = (value?: string) => {
  if (!value) return '';

  const date = new Date(value);
  const pad = (chunk: number) => String(chunk).padStart(2, '0');

  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
};

const getDraftEndAt = (value?: string) => {
  if (!value) return undefined;

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return undefined;

  date.setHours(date.getHours() + 1);
  return date.toISOString();
};

const defaultStartsAt = event?.startsAt ?? draftStartsAt;
const defaultEndsAt = event?.endsAt ?? getDraftEndAt(draftStartsAt);
const canCreateEvent = clients.length > 0 && eventTypes.length > 0;
---

{
  open && (
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/45 px-4 py-5 backdrop-blur-md">
      <div class="max-h-[calc(100dvh-2.5rem)] w-full max-w-3xl overflow-y-auto rounded-[22px] border border-white/90 bg-[#fbfcff] shadow-[0_32px_100px_-24px_rgba(15,23,42,0.55)]">
        <div class="flex items-center justify-between gap-4 px-5 pb-4 pt-5 md:px-7 md:pb-5 md:pt-6">
          <div class="flex min-w-0 items-center gap-4">
            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange-50 text-orange-500" aria-hidden="true">
              <Icon name="calendar" size={21} strokeWidth={2} />
            </span>
            <div class="min-w-0">
              <p class="font-display text-2xl font-semibold text-slate-900 md:text-[28px]">
                {event ? 'Editar evento' : 'Nuevo evento'}
              </p>
              <p class="mt-1 text-xs text-slate-500 md:text-sm">
                {event ? 'Actualiza los detalles de este evento.' : 'Crea un nuevo evento en tu calendario.'}
              </p>
            </div>
          </div>
          <a
            href={closeHref}
            class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-400 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-300 focus-visible:ring-offset-2"
            aria-label="Cerrar modal"
          >
            <Icon name="close" size={16} />
          </a>
        </div>

        <div class="px-5 pb-5 md:px-7 md:pb-6">
          {!canCreateEvent && (
            <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
              Necesitas al menos una empresa y un tipo de evento activos para crear eventos.
            </div>
          )}

        <form method="POST" action="/api/events">
          <input type="hidden" name="_action" value="save" />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          {event && <input type="hidden" name="id" value={event.id} />}

          <div class="grid gap-5 md:grid-cols-2">
            <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-[0_8px_24px_-20px_rgba(15,23,42,0.25)]">
              <div class="flex items-center gap-2 text-orange-500">
                <Icon name="company" size={16} strokeWidth={2} />
                <p class="text-xs font-bold uppercase tracking-wide">Información</p>
              </div>
              <div class="mt-5 space-y-4">
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Título del evento</span>
                  <input
                    name="title"
                    required
                    placeholder="Escribe el título..."
                    class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-orange-400 focus:ring-4 focus:ring-orange-100"
                    value={event?.title ?? ''}
                  />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Empresa</span>
                  <select
                    id="event-client-select"
                    name="clientId"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition hover:border-slate-300 focus:border-orange-400 focus:ring-4 focus:ring-orange-100"
                  >
                    {clients.map((client) => (
                      <option
                        value={client.id}
                        selected={event?.clientId === client.id || (!event && selectedClient?.id === client.id)}
                        data-client-color={client.color}
                        data-client-name={client.name}
                      >
                        {client.name}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Tipo de evento</span>
                  <select
                    name="eventTypeId"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition hover:border-slate-300 focus:border-orange-400 focus:ring-4 focus:ring-orange-100"
                  >
                    {eventTypes.map((type) => (
                      <option value={type.id} selected={event?.eventTypeId === type.id}>
                        {type.name}
                      </option>
                    ))}
                  </select>
                </label>
              </div>
            </section>

            <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-[0_8px_24px_-20px_rgba(15,23,42,0.25)]">
              <div class="flex items-center gap-2 text-emerald-600">
                <Icon name="calendar" size={16} strokeWidth={2} />
                <p class="text-xs font-bold uppercase tracking-wide">Fechas</p>
              </div>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Fecha de inicio</span>
                  <input
                    type="datetime-local"
                    name="startsAt"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm outline-none transition hover:border-slate-300 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                    value={toDateTimeLocal(defaultStartsAt)}
                  />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Fecha de fin</span>
                  <input
                    type="datetime-local"
                    name="endsAt"
                    class="w-full rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm outline-none transition hover:border-slate-300 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                    value={toDateTimeLocal(defaultEndsAt)}
                  />
                </label>
              </div>
              <label class="mt-10 block border-t border-slate-100 pt-6">
                <span class="mb-2 block text-xs font-semibold text-slate-700">Estado</span>
                <select
                  name="status"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition hover:border-slate-300 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                >
                  {[
                    ['pending', 'Pendiente'],
                    ['in_progress', 'En revisión'],
                    ['published', 'Publicado'],
                    ['completed', 'Confirmada'],
                    ['cancelled', 'Cancelado'],
                  ].map(([value, label]) => (
                    <option value={value} selected={event?.status === value || (!event && value === 'pending')}>
                      {label}
                    </option>
                  ))}
                </select>
              </label>
            </section>

            <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-[0_8px_24px_-20px_rgba(15,23,42,0.25)]">
              <div class="flex items-center gap-2 text-blue-500">
                <Icon name="edit" size={16} strokeWidth={2} />
                <p class="text-xs font-bold uppercase tracking-wide">Producción</p>
              </div>
              <label class="mt-5 block">
                <span class="mb-2 block text-xs font-semibold text-slate-700">Descripción</span>
                <textarea
                  name="description"
                  placeholder="Añade una descripción del evento..."
                  class="min-h-36 w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                >{event?.description ?? ''}</textarea>
              </label>
            </section>

            <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-[0_8px_24px_-20px_rgba(15,23,42,0.25)]">
              <div class="flex items-center gap-2 text-purple-500">
                <Icon name="user" size={16} strokeWidth={2} />
                <p class="text-xs font-bold uppercase tracking-wide">Recursos</p>
              </div>
              <div class="mt-5 space-y-4">
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Responsable</span>
                  <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700">
                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-purple-50 text-purple-500">
                      <Icon name="user" size={15} />
                    </span>
                    <span class="truncate">{currentUser.name} · {currentUser.title}</span>
                  </div>
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold text-slate-700">Color del evento</span>
                  <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
                    <div class="flex items-center gap-3">
                      <span
                        id="event-client-color-preview"
                        class="h-8 w-8 rounded-full border-4 border-white shadow ring-1 ring-slate-200"
                        style={`background:${selectedClient?.color ?? '#4f46e5'};`}
                      />
                      <div>
                        <p class="text-sm font-semibold text-slate-800">Heredado de la empresa</p>
                        <p id="event-client-color-label" class="text-xs text-slate-500">
                          {selectedClient ? `${selectedClient.name} · ${selectedClient.color}` : 'Selecciona una empresa'}
                        </p>
                      </div>
                    </div>
                  </div>
                </label>
              </div>
            </section>
          </div>

          <div class="mt-6 flex flex-col gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:justify-end">
            <a href={closeHref} class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300 focus-visible:ring-offset-2">Cancelar</a>
            <button
              disabled={!canCreateEvent}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[linear-gradient(135deg,_#ff9f2f,_#ff5b35)] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition hover:-translate-y-0.5 hover:brightness-105 hover:shadow-xl hover:shadow-orange-500/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <Icon name="calendar" size={16} />
              {event ? 'Guardar cambios' : 'Guardar evento'}
            </button>
          </div>
        </form>
        </div>
      </div>
    </div>
  )
}

<script>
  const clientSelect = document.querySelector('#event-client-select');
  const preview = document.querySelector('#event-client-color-preview');
  const label = document.querySelector('#event-client-color-label');

  const syncClientColor = () => {
    if (
      !(clientSelect instanceof HTMLSelectElement) ||
      !(preview instanceof HTMLElement) ||
      !(label instanceof HTMLElement)
    ) {
      return;
    }

    const selectedOption = clientSelect.selectedOptions[0];
    const color = selectedOption?.dataset.clientColor;
    const name = selectedOption?.dataset.clientName;

    if (!color || !name) {
      return;
    }

    preview.style.background = color;
    label.textContent = `${name} · ${color}`;
  };

  syncClientColor();
  clientSelect?.addEventListener('change', syncClientColor);
</script>
